# This service's own database, from its own docker-compose.yml
POSTGRES_USER=recs
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=recs
DATABASE_URL="postgresql://recs:replace-me@localhost:5433/recs"

# The catalogue, read over its public API. This service never touches core's database.
CORE_BASE_URL="http://localhost:3001"

OPENAI_API_KEY=replace-me
# Optional. Point this at any OpenAI-compatible endpoint, which is how the llm-gateway
# will be slotted in front without changing a line of code.
# OPENAI_BASE_URL="http://localhost:4000/v1"

# Changing either of these makes every stored vector stale, and the next rebuild redoes them all
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
